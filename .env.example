# ---------------------------------------------------------------
# Wizz Jewels — environment variables
# Copy to .env (local) or add in Vercel → Project → Settings → Environment Variables.
# ---------------------------------------------------------------

# Postgres connection string. Local: `docker compose up -d` gives you this one.
# Production: Neon / Supabase connection string (pooled is fine; add ?sslmode=require).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wizz?schema=public"

# Public origin, used for canonical URLs, sitemap, emails and calendar links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin dashboard (/admin). Generate the hash with:  npm run admin:hash -- "your long password"
ADMIN_PASSWORD_HASH=""
# 32+ random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=""

# Where new-booking and contact notifications are sent (defaults to the email in content/site.ts).
STUDIO_NOTIFICATION_EMAIL=""

# Email — Resend (recommended). Verify your sending domain in Resend first.
RESEND_API_KEY=""
EMAIL_FROM="Wizz Jewels <bookings@your-domain.co.uk>"

# Email — SMTP fallback (used only when RESEND_API_KEY is empty).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
# With neither Resend nor SMTP set, development emails are written to ./.outbox as HTML.

# Private storage for booking reference images (Vercel → Storage → Blob, private store).
# Leave empty locally: files are saved to ./storage/uploads.
BLOB_READ_WRITE_TOKEN=""

# Optional Cloudflare Turnstile spam protection (both must be set to enable it).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Set to "true" only for automated tests.
RATE_LIMIT_DISABLED=""
